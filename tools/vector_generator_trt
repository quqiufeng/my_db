#!/bin/bash
# Wrapper script to run vector_generator with TensorRT 10 libraries
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

export LD_LIBRARY_PATH="${PROJECT_DIR}:/opt/TensorRT-10/lib:/data/venv/lib:${LD_LIBRARY_PATH}"

exec "${PROJECT_DIR}/tools/vector_generator" "$@"
