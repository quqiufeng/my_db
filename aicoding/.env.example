# aicoding configuration
# Copy this file to ./.env in your project, or to ~/.aicoding/.env for global use.
# Keep it secret. .env files are excluded from git.

# ============================================================
# Option 1: Kimi (OpenAI-compatible endpoint)
# ============================================================
LLM_PROTOCOL=openai
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.kimi.com/coding/v1
OPENAI_MODEL=kimi-latest

# Kimi /coding endpoint requires spoofing the KimiCLI client identity
LLM_USER_AGENT=KimiCLI/1.0.0
LLM_EXTRA_HEADER=x-opencode-version: 1.17.6

# kimi-latest requires temperature=1.0
LLM_TEMPERATURE=1.0

# ============================================================
# Option 2: DeepSeek (OpenAI-compatible endpoint)
# ============================================================
# LLM_PROTOCOL=openai
# DEEPSEEK_API_KEY=your-deepseek-key
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-flash
# LLM_TEMPERATURE=1.0

# ============================================================
# Option 3: Anthropic / Claude
# ============================================================
# LLM_PROTOCOL=anthropic
# ANTHROPIC_API_KEY=sk-...
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
# LLM_TEMPERATURE=1.0

# ============================================================
# Option 4: Any other OpenAI-compatible provider
# ============================================================
# LLM_PROTOCOL=openai
# OPENAI_API_KEY=your-key
# OPENAI_BASE_URL=https://api.example.com/v1
# OPENAI_MODEL=your-model
# LLM_TEMPERATURE=1.0
